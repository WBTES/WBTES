rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function profile() {
      return get(userPath()).data;
    }

    function active() {
      return hasProfile()
        && (!(profile().role in ['hr', 'department_head'])
          || request.auth.token.email_verified == true)
        && profile().get('status', 'active') == 'active';
    }

    function roleIs(expectedRole) {
      return active() && profile().role == expectedRole;
    }

    function isAdmin() {
      return roleIs('admin');
    }

    function isStudent() {
      return roleIs('student');
    }

    function isDepartmentHead() {
      return roleIs('department_head');
    }

    function isHr() {
      return roleIs('hr');
    }

    function isDepartmentStaff() {
      return isHr() || isDepartmentHead();
    }

    function isOwnProfile(userId) {
      return active() && request.auth.uid == userId;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOwnCompletion() {
      return isStudent() && resource.data.studentId == request.auth.uid;
    }

    function isOwnAssignment() {
      return isStudent()
        && request.auth.uid in resource.data.studentIds;
    }

    function isDepartmentRecord() {
      return isDepartmentStaff();
    }

    function isReleasedDepartmentRecord() {
      return isDepartmentRecord()
        && resource.data.periodId is string
        && exists(/databases/$(database)/documents/evaluationPeriods/$(resource.data.periodId))
        && get(/databases/$(database)/documents/evaluationPeriods/$(resource.data.periodId)).data.status == 'closed';
    }

    // User and student-registration creation is handled by authenticated server
    // routes so a browser can never choose its own role or academic scope.
    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin() && resource.data.role != 'admin';
      allow update: if isAdmin()
        || (isOwnProfile(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 150
          && (request.resource.data.get('photoURL', null) == null
            || request.resource.data.get('photoURL', null) is string)
          && request.resource.data.updatedAt is number);
    }

    match /studentRegistry/{registrationId} {
      allow read, write: if false;
    }

    match /departments/{departmentId} {
      allow read: if isAdmin()
        || isStudent()
        || isDepartmentStaff();
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if isAdmin()
        || isStudent()
        || isDepartmentStaff();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAdmin()
        || isStudent()
        || isDepartmentStaff();
      allow write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin()
        || isStudent()
        || isDepartmentStaff();
      allow write: if isAdmin();
    }

    match /evaluationQuestions/{questionId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /evaluationForms/{formId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /evaluationPeriods/{periodId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /teacherAssignments/{assignmentId} {
      allow read: if isAdmin() || isOwnAssignment();
      allow write: if isAdmin();
    }

    // Anonymous response documents deliberately contain no student identifier.
    // All submissions are validated and written by /api/evaluations/submit.
    match /evaluations/{evaluationId} {
      allow read: if isAdmin() || (isHr() && isReleasedDepartmentRecord());
      allow create, update, delete: if false;
    }

    // Identity-bearing completion receipts are stored separately from answers.
    match /evaluationCompletions/{completionId} {
      allow read: if isAdmin() || isOwnCompletion();
      allow create, update, delete: if false;
    }

    // Targeted announcement visibility is evaluated by /api/announcements.
    // Administrators retain direct access for the management screen.
    match /announcements/{announcementId} {
      allow read, write: if isAdmin();
    }

    match /performanceReports/{reportId} {
      allow read: if isAdmin() || (isHr() && isReleasedDepartmentRecord());
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if active() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if active()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if active() && resource.data.userId == request.auth.uid;
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // These collections are accessible only through privileged server routes.
    match /systemBackups/{backupId} {
      allow read, write: if false;

      match /documents/{documentId} {
        allow read, write: if false;
      }
    }

    match /systemState/{stateId} {
      allow read, write: if false;
    }

    match /maintenanceDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /loginEvents/{eventId} {
      allow read, write: if false;
    }

    match /systemSettings/{settingId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
