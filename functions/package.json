    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.0.1",
    "nodemailer": "^9.0.3",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.6.3"
  },
  "private": true
}
