# Copy this file to functions/.env. Never commit the real credentials.

# Optional AI-assisted performance reports
GEMINI_API_KEY=

# SMTP email delivery
# Gmail / Google Workspace: smtp.gmail.com, port 587, secure false
# Microsoft 365: smtp.office365.com, port 587, secure false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WBTE
