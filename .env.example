# WBTE root server configuration
# Copy to .env.local (or .env) in the project root. Never commit real secrets.

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK: Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# Public app and school branding.
# Replace localhost with the deployed HTTPS URL before production use.
# Local verification links finish on Firebase's hosted confirmation page.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Static confirmation page deployed with npm run deploy:verification.
FIREBASE_EMAIL_ACTION_URL=
NEXT_PUBLIC_SCHOOL_NAME=
# Use a file in public, such as /school-logo.png, or an HTTPS image URL.
NEXT_PUBLIC_SCHOOL_LOGO_URL=
NEXT_PUBLIC_CONTACT_EMAIL=feedback.wbtes@gmail.com

# Optional comma-separated domains allowed for public student registration.
# Leave empty only when the school intentionally accepts personal email domains.
SCHOOL_EMAIL_DOMAINS=

# SMTP used by registration, verification, approval, announcements, alerts, reminders, receipts, and contact.
# Gmail requires 2-Step Verification plus an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WBTE
CONTACT_EMAIL=

# Optional real AI analysis. Leave the key blank for deterministic rule analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Long random secret for a free external cron request to /api/maintenance/run.
MAINTENANCE_SECRET=
